# Optional AI command understanding. When omitted, the deterministic parser is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Paths are relative to the repository root unless absolute paths are supplied.
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json
DATABASE_PATH=data/gmail_cleaner.sqlite3

# Safety controls
MAX_MESSAGES_PER_PREVIEW=200
PREVIEW_TTL_MINUTES=15

# Optional API protection. Set a long random value before exposing the API
# beyond your own machine. Keep the API bound to 127.0.0.1 for local use.
API_BEARER_TOKEN=
